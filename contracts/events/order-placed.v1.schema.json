{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-core.local/events/order-placed.v1.schema.json",
  "title": "OrderPlacedEvent",
  "description": "客户成功提交订单事实；包含权威报价单、金额及商品明细，驱动下游库存预留与支付预授权",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "com.ecommerce.ordering.order-placed.v1"
    },
    "source": {
      "const": "/contexts/ordering"
    },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "customer_id",
        "quote_id",
        "quote_version",
        "total_amount_minor",
        "currency",
        "items"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid",
          "description": "订单全局唯一标识 UUID"
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "description": "下单客户标识"
        },
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "description": "权威价格报价单标识"
        },
        "quote_version": {
          "type": "string",
          "minLength": 1,
          "description": "报价单版本号"
        },
        "total_amount_minor": {
          "type": "integer",
          "minimum": 0,
          "description": "订单总金额（最小货币单位，如分）"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 三位货币代码"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "订单包含的商品行项明细列表（用于库存预留自包含履约）",
          "items": {
            "type": "object",
            "required": [
              "sku_id",
              "quantity",
              "unit_price_minor"
            ],
            "properties": {
              "sku_id": {
                "type": "string",
                "minLength": 1,
                "description": "商品 SKU 标识"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "购买数量"
              },
              "unit_price_minor": {
                "type": "integer",
                "minimum": 0,
                "description": "商品单价（最小货币单位，如分）"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
