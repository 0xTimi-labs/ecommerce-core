{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentCapturedEvent",
  "type": "object",
  "required": [
    "eventId",
    "paymentId",
    "orderId",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
