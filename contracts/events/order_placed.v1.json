{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderPlacedV1",
  "type": "object",
  "required": [
    "event_id",
    "order_id",
    "customer_id",
    "items",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku_id",
          "quantity",
          "unit_price_cents",
          "currency"
        ],
        "properties": {
          "sku_id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          }
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
