{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderPlacedEvent",
  "type": "object",
  "required": [
    "event_id",
    "order_id",
    "customer_id",
    "items",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku_id",
          "quantity",
          "unit_price_cents",
          "currency"
        ],
        "properties": {
          "sku_id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": ["CNY", "USD", "EUR"]
          }
        },
        "additionalProperties": false
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
