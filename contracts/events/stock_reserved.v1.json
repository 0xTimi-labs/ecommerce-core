{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockReservedEvent",
  "type": "object",
  "required": [
    "event_id",
    "reservation_id",
    "order_id",
    "items",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "reservation_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku_id",
          "quantity"
        ],
        "properties": {
          "sku_id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
