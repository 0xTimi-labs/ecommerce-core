{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockReservedV1",
  "type": "object",
  "required": [
    "event_id",
    "reservation_id",
    "order_id",
    "sku_id",
    "quantity",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "reservation_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "sku_id": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
