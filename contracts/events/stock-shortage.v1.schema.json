{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-core.local/events/stock-shortage.v1.schema.json",
  "title": "StockShortage v1 (CloudEvents)",
  "description": "实物库存不足事实；触发订单自动取消并通知客户缺货补偿",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "com.ecommerce.inventory.stock-shortage.v1"
    },
    "source": {
      "const": "/contexts/inventory"
    },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "unavailable_items"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid",
          "description": "关联订单唯一标识 UUID"
        },
        "unavailable_items": {
          "type": "array",
          "minItems": 1,
          "description": "缺货商品明细列表",
          "items": {
            "type": "object",
            "required": [
              "sku_id",
              "requested_quantity",
              "available_quantity"
            ],
            "properties": {
              "sku_id": {
                "type": "string",
                "minLength": 1,
                "description": "缺货商品 SKU 标识"
              },
              "requested_quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "下单请求购买数量"
              },
              "available_quantity": {
                "type": "integer",
                "minimum": 0,
                "description": "当前可用实际库存量"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
