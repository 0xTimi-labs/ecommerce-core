{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-core-reference.local/events/payment-authorized.v1.schema.json",
  "title": "PaymentAuthorized v1",
  "description": "资金冻结事实，不表示 Order 已付款",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "payment_authorized"
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "required": [
        "payment_id",
        "authorization_id",
        "order_id",
        "amount_minor",
        "currency"
      ],
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "authorization_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
