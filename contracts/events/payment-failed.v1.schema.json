{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-core.local/events/payment-failed.v1.schema.json",
  "title": "PaymentFailed v1 (CloudEvents)",
  "description": "支付授权或请款失败事实；触发订单状态流转至取消并触发分布式逆向补偿",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "com.ecommerce.payment.payment-failed.v1"
    },
    "source": {
      "const": "/contexts/payment"
    },
    "data": {
      "type": "object",
      "required": [
        "payment_id",
        "order_id",
        "amount_minor",
        "currency",
        "error_code",
        "reason"
      ],
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid",
          "description": "支付单唯一标识 UUID"
        },
        "order_id": {
          "type": "string",
          "format": "uuid",
          "description": "关联订单唯一标识 UUID"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "description": "拟支付金额"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 三位货币代码"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "description": "支付网关失败错误代码（如 insufficient_funds, card_expired, risk_rejected）"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "支付失败具体原因说明"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
