{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-core-reference.local/events/payment-captured.v1.schema.json",
  "title": "PaymentCaptured v1",
  "description": "实际扣款事实；未来获批 Ordering Slice 才可据此推进 Paid",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "payment_captured"
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "required": [
        "payment_id",
        "capture_id",
        "order_id",
        "amount_minor",
        "currency"
      ],
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
