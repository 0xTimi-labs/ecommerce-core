{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentAuthorizedEvent",
  "type": "object",
  "required": [
    "event_id",
    "payment_id",
    "order_id",
    "customer_id",
    "amount_cents",
    "currency",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "payment_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string"
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": ["CNY", "USD", "EUR"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
